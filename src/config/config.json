{
  "development": {
    "username": "postgres",
    "password": "password",
    "database": "skyflow_dev",
    "host": "127.0.0.1",
    "dialect": "postgres",
    "logging": false,
    "pool": {
      "max": 5,
      "min": 0,
      "acquire": 30000,
      "idle": 10000
    }
  },
  "test": {
    "username": "postgres",
    "password": "password",
    "database": "skyflow_test",
    "host": "127.0.0.1",
    "dialect": "postgres",
    "logging": false,
    "pool": {
      "max": 5,
      "min": 0,
      "acquire": 30000,
      "idle": 10000
    }
  },
  "production": {
    "use_env_variable": "DATABASE_URL",
    "dialect": "postgres",
    "logging": false,
    "pool": {
      "max": 10,
      "min": 2,
      "acquire": 30000,
      "idle": 10000
    },
    "dialectOptions": {
      "ssl": {
        "require": true,
        "rejectUnauthorized": false
      }
    }
  },
  "mysql": {
    "development": {
      "username": "root",
      "password": "password",
      "database": "skyflow_dev",
      "host": "127.0.0.1",
      "dialect": "mysql",
      "logging": false
    },
    "test": {
      "username": "root",
      "password": "password",
      "database": "skyflow_test",
      "host": "127.0.0.1",
      "dialect": "mysql",
      "logging": false
    },
    "production": {
      "use_env_variable": "MYSQL_DATABASE_URL",
      "dialect": "mysql",
      "logging": false,
      "pool": {
        "max": 10,
        "min": 2,
        "acquire": 30000,
        "idle": 10000
      }
    }
  }
}
